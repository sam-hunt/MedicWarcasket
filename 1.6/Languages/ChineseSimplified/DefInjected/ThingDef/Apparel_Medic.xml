  <MDWC_Warcasket_Medic.comps.CompDressingSuite.cooldownGerund>冷却中</MDWC_Warcasket_Medic.comps.CompDressingSuite.cooldownGerund>

  <!-- EN: medic warcasket shoulders -->
  <MDWC_WarcasketShoulders_Medic.label>医疗型战棺护肩</MDWC_WarcasketShoulders_Medic.label>
  <!-- EN: Specialized spacer-tech warcasket pauldrons with standard protection, equipped with an adrenaline injector and field-medicine manipulators that quicken the pilot's tending. -->
