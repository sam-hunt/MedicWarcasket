<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!--
    Save Our Ship 2 / Universum parity. VFEP's own SOS2Patch.xml gives its warcasket armor and
    helmets the EVA apparel tag and a flat Insulation_Cold 100, matching by defName, so it never
    reaches ours; this applies the same two operations to the Medic armor and helmet.
    Shoulder pads are left alone, as in VFEP.

    The gate is PatchOperationFindMod on display names, copied verbatim from VFEP's patch on
    purpose: this must fire under exactly VFEP's condition so the two sets never disagree about
    being EVA-rated. If VFEP changes its gate, change this one to match.
  -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Save Our Ship 2</li>
      <li>Universum</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/VFEPirates.WarcasketDef[defName = "MDWC_Warcasket_Medic" or defName = "MDWC_WarcasketHelmet_Medic"]/apparel/tags</xpath>
          <value>
            <li>EVA</li>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/VFEPirates.WarcasketDef[defName = "MDWC_Warcasket_Medic" or defName = "MDWC_WarcasketHelmet_Medic"]/statBases/Insulation_Cold</xpath>
          <value>
            <Insulation_Cold>100</Insulation_Cold>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
