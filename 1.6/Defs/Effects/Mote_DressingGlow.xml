<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!--
    The mechanite dressing's emitter: a soft glow in the dressing's colour (the beam's header) in
    front of the pilot from the warmup through the beam. The graphic (BrightFlash under MoteGlow)
    is Core's Mote_ActivatorCountdownGlow on a MoteAttached in place of its MoteThrown, so it
    follows the pilot; a copy rather than a child because the class, tint, size and offset all
    differ. Attached with MakeAttachedOverlay and maintained every tick; fadeOutUnmaintained
    gives an interrupted job a short fade, and code fades it over the warmdown through
    instanceColor's alpha. The huge solidTime keeps a maintained mote from timing out.
  -->
  <ThingDef ParentName="MoteBase">
    <defName>MDWC_Mote_DressingGlow</defName>
    <thingClass>MoteAttached</thingClass>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <mote>
      <fadeInTime>0.1</fadeInTime>
      <solidTime>999999999</solidTime>
      <fadeOutTime>0.25</fadeOutTime>
      <needsMaintenance>True</needsMaintenance>
      <fadeOutUnmaintained>True</fadeOutUnmaintained>
    </mote>
    <graphicData>
      <drawSize>1</drawSize>
      <color>(0.388, 0.624, 0.886, 0.55)</color>
      <texPath>Things/Mote/BrightFlash</texPath>
      <shaderType>MoteGlow</shaderType>
    </graphicData>
  </ThingDef>
</Defs>
